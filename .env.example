# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL_VISION=gpt-4o
OPENAI_MODEL_TEXT=gpt-4-turbo-preview

# MongoDB Configuration
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE=nutrition_bot

# Bot Settings
BOT_LANGUAGE=ru
TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO

# Reports Schedule (cron format)
DAILY_REPORT_TIME=21:00
WEEKLY_REPORT_DAY=monday
WEEKLY_REPORT_TIME=09:00

# OpenAI Cost Tracking
OPENAI_COST_LIMIT_DAILY=10.0  # USD per day
OPENAI_COST_WARN_THRESHOLD=0.8  # Warn at 80% of limit

# Image Optimization
MAX_IMAGE_SIZE=2048  # pixels
IMAGE_QUALITY=85  # 0-100

# Rate Limiting
RATE_LIMIT_MESSAGES=30  # messages per minute per user
