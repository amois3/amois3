# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_new_telegram_bot_token

# Gemini Configuration
GEMINI_API_KEY=your_new_gemini_api_key
GEMINI_MODEL_VISION=gemini-1.5-pro-latest
GEMINI_MODEL_TEXT=gemini-1.5-pro-latest

# MongoDB Configuration
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE=nutrition_bot

# Bot Settings
BOT_LANGUAGE=ru
TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO

# Reports Schedule (cron format)
DAILY_REPORT_TIME=21:00
WEEKLY_REPORT_DAY=monday
WEEKLY_REPORT_TIME=09:00

# Image Optimization
MAX_IMAGE_SIZE=2048  # pixels
IMAGE_QUALITY=85  # 0-100

# Rate Limiting
RATE_LIMIT_MESSAGES=30  # messages per minute per user
